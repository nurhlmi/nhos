# ---------------------------------------------------------------------------
# Environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects can use the anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Product name shown in the UI and page titles. Defaults to "nhOS".
NEXT_PUBLIC_APP_NAME=nhOS

# Public URL of the deployed app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, optional. NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Without a key NVD allows 5 requests / 30 s; with a key 50 requests / 30 s.
NVD_API_KEY=

# Server-only, required for Movies. TMDB (https://www.themoviedb.org/settings/api):
# set the "API Read Access Token" (preferred) or the v3 "API Key".
TMDB_API_READ_TOKEN=
TMDB_API_KEY=


# ---------------------------------------------------------------------------
# Only for `pnpm owner:create` (one-off owner account creation; the owner
# email is fixed in src/config/owner.ts). Remove it once the owner exists.
# Never used by the running app and never prefixed with NEXT_PUBLIC_. Leave empty on your hosting provider.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
